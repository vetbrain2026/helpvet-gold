# Excecao explicita: apenas .md, .txt e .json em fixtures/sinteticos/ e contrato/
# (PDF, CSV e imagem continuam bloqueados tambem ali).
!fixtures/sinteticos/
!fixtures/sinteticos/**/*.md
!fixtures/sinteticos/**/*.txt
!fixtures/sinteticos/**/*.json
!contrato/
!contrato/**/*.md
!contrato/**/*.txt
!contrato/**/*.json

